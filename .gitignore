# Compiled binaries. The trailing * catches cross-compiled output too -
# `GOOS=linux go build -o lodestoned-linux` and friends.
/lodestone
/lodestone-*
/lodestoned
/lodestoned-*
/dist/
*.exe
*.dll
*.so
*.dylib

# Test binaries and coverage output
*.test
*.out
coverage.*

# Go workspace files (local, machine-specific)
go.work
go.work.sum

# Local environment / secrets — never commit these
.env
*.local

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
